# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só em rota de servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Assina o cookie de acesso. Qualquer texto longo e aleatório serve.
SESSAO_SECRET=

# URL pública do app, sem barra no final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só dígitos, com DDI e DDD. Ex: 5511999998888
NEXT_PUBLIC_WHATSAPP_NUMERO=5511919005590
# Perfil do Instagram mostrado na tela de entrada
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/decorar.semcomplicacao/

# Checkout do upgrade Básico -> Completo, e o preço mostrado no botão (ex: R$ 19,90).
# Preço vazio = o botão sai só com "Quero o Pacote Completo".
NEXT_PUBLIC_CHECKOUT_UPGRADE_URL=https://ggcheckout.app/checkout/v5/NuTIRfsxypFzjKAOivEi
NEXT_PUBLIC_PRECO_UPGRADE=R$ 6,90

# Página de vendas da Biblioteca Visual da Decoradora de Festas (tela Calculadora).
# O app acrescenta ?origem=app-festas sozinho se a URL não tiver.
NEXT_PUBLIC_BIBLIOTECA_URL=https://bibliotecavisualdecoradoradefestas.vercel.app
# Checkout da Biblioteca (botão verde do popup). Vazio = o botão vai para a página acima.
NEXT_PUBLIC_BIBLIOTECA_CHECKOUT_URL=https://ggcheckout.app/checkout/v5/xYVqaTz2T2RoF1u81Ops
# Mensalidade da Biblioteca (assinatura), sem o "/mês": o app acrescenta. Vazio = sem preço.
NEXT_PUBLIC_PRECO_BIBLIOTECA=R$ 12,90

# Deixe vazio para esconder o banner
NEXT_PUBLIC_BANNER_NOVIDADE=
NEXT_PUBLIC_BANNER_NOVIDADE_URL=

# Webhook de compra (GGCheckout)
# Mesmo segredo cadastrado na GGCheckout; chega em x-secret ou Authorization: Bearer.
WEBHOOK_SECRET=
# IDs dos produtos na GGCheckout, separados por vírgula. Podem ficar vazios se o
# plano for decidido pelo valor pago (abaixo).
WEBHOOK_PRODUTOS_BASICO=AhcuLW7B0yATLyaYSdK5
WEBHOOK_PRODUTOS_COMPLETO=6jfVtbCkP0kG2phGqapy
WEBHOOK_PRODUTOS_UPGRADE=
# Rede de segurança: plano dado a compra sem ID conhecido e sem valor (basico | completo).
WEBHOOK_PRODUTO_PADRAO=basico

# Plano pelo valor pago (Básico R$ 10; Completo R$ 17,90 ou 29,90; upgrade R$ 6,90): a partir de MIN_COMPLETO
# é completo; perto de VALOR_UPGRADE é upgrade (vazio = não usa); abaixo, básico.
WEBHOOK_VALOR_MIN_COMPLETO=16
WEBHOOK_VALOR_UPGRADE=6.90

# E-mails com acesso ao /admin, separados por vírgula
ADMIN_EMAILS=

# E-mails com acesso a tudo (separados por vírgula): entram sem compra, veem
# todos os módulos e usam a calculadora de verdade (aba Calculadora e /historico).
ACESSO_TOTAL_EMAILS=
